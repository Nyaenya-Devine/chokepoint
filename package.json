{
  "name": "chokepoint",
  "version": "2.0.0",
  "private": true,
  "description": "Chokepoint v2.0 — Live Security Operations Lab with real-time endless requests, voice approvals 5 balanced voices, remote verification encrypted sessions, per-tenant policies NovaTech/Bloom/Apex, mock security portals, HMAC-signed tamper-evident audit, desktop PWA+Electron",
  "main": "electron.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "lint": "next lint",
    "desktop": "electron .",
    "desktop:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:dist": "npm run build && electron-builder --publish=never"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.1.11",
    "typescript": "5.5.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
