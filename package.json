{
  "name": "chokepoint",
  "version": "3.1.0",
  "private": true,
  "description": "Chokepoint v3.1 — least-privilege access control and tamper-evident audit for sensitive operations.",
  "author": "Devine Nyaenya <devinenyaenya@gmail.com>",
  "homepage": "https://github.com/Nyaenya-Devine/chokepoint",
  "main": "electron.js",
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "lint": "next lint",
    "desktop": "electron .",
    "desktop:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:dist": "npm run build && electron-builder --publish=never",
    "desktop:dist:win": "electron-builder --win --publish=never",
    "desktop:dist:mac": "electron-builder --mac --publish=never",
    "desktop:dist:linux": "electron-builder --linux --publish=never",
    "desktop:publish": "electron-builder --publish=always",
    "sbom": "cyclonedx-npm --output-file sbom.json --output-format json",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "electron-log": "^5.2.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.454.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@types/node": "^20.19.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.1.11",
    "concurrently": "^8.2.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "5.5.3",
    "vitest": "^4.0.15",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.chokepoint.security",
    "productName": "Chokepoint",
    "copyright": "© 2026 Chokepoint — Least-Privilege Dual-Control Tamper-Evident — MIT — Devine Nyaenya",
    "directories": { "output": "dist", "buildResources": "public" },
    "files": ["electron.js", "preload.js", "out/**/*", "public/**/*", "!**/*.map"],
    "asar": true,
    "asarUnpack": ["**/*.node"],
    "mac": {
      "category": "public.app-category.business",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }, { "target": "zip", "arch": ["x64", "arm64"] }],
      "icon": "public/icon-512.png",
      "darkModeSupport": true,
      "gatekeeperAssess": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "public/icon-512.png",
      "publisherName": "Devine Nyaenya",
      "verifyUpdateCodeSignature": true
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }],
      "icon": "public/icon-512.png",
      "category": "Office"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "Chokepoint-Setup-${version}.${ext}" },
    "publish": { "provider": "github", "owner": "Nyaenya-Devine", "repo": "chokepoint", "private": false, "releaseType": "release" }
  },
  "engines": { "node": ">=18.18.0" },
  "keywords": ["least-privilege", "dual-control", "tamper-evident", "hmac", "hash-chain", "security", "owasp", "rbac", "siem", "electron", "desktop-app"]
}
